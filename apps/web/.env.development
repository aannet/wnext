# Identité de développement (AUTH_MODE=dev de l API), cohérente avec le jeu d essai de `npm run dev:stack`. Aucun secret.
VITE_AUTH_MODE=dev
VITE_DEV_ACCOUNT_ID=1
VITE_DEV_USER_ID=1
VITE_DEV_ROLE=admin
# Connexion OIDC locale (recette) : `npm run dev:recette`, qui lance la pile en --oidc et l écran en VITE_AUTH_MODE=oidc.
# Lancer `npm run dev -w @wnext/web` seul face à une API en OIDC donne « Session expirée » (en-têtes x-dev-* refusés, RT-035).
VITE_OIDC_ISSUER=http://127.0.0.1:3010
VITE_OIDC_CLIENT_ID=wnext-web
