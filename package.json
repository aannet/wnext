{
  "name": "wnext",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts",
    "packages/engine",
    "packages/contracts-tools"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:fast": "vitest run --config vitest.check.config.ts",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "lint:ui-strings": "node scripts/lint-ui-strings.mjs",
    "test:boundaries": "vitest run tests/boundaries",
    "test:parity": "vitest run tests/parity",
    "test:e2e": "vitest run tests/e2e",
    "test:concurrency": "vitest run tests/concurrency",
    "test:migrations": "vitest run tests/migrations",
    "db:migrate": "node scripts/migrate.mjs",
    "dev:stack": "node scripts/dev-stack.mjs",
    "test:schemathesis": "node tests/schemathesis/run.mjs",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts",
    "test:browser:oidc": "playwright test -c tests/browser/playwright.oidc.config.ts",
    "bench:browser": "node tests/browser/bench.mjs",
    "perf:realtime": "vitest run tests/perf/realtime-propagation.test.ts --reporter=verbose",
    "perf:engine": "vitest run tests/perf/engine-scale.test.ts --reporter=verbose",
    "guard:test-weakening": "node scripts/guardrails/test-weakening.mjs",
    "guard:pr-size": "node scripts/guardrails/pr-size.mjs",
    "guard:br-coverage": "node scripts/guardrails/br-coverage.mjs",
    "test:guardrails": "vitest run tests/guardrails",
    "prove:guardrails": "node tests/guardrails/prove-guardrails.mjs",
    "factory:stop": "node factory/bin/factory.mjs stop --all",
    "factory:status": "node factory/bin/factory.mjs status",
    "factory:dry-run": "npm --prefix factory/observability run dry-run",
    "generate:contract": "npm run generate -w @wnext/contracts-tools",
    "check:contract": "npm run check:contract -w @wnext/contracts-tools",
    "check:breaking": "npm run check:breaking -w @wnext/contracts-tools"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "embedded-postgres": "18.4.0-beta.17",
    "oxc-parser": "0.154.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
